---
import Base from '../layouts/Base.astro';
import CalculatorGrid from '../components/CalculatorGrid.astro';
import { CATEGORIES, calculatorsIn, type CategoryId } from '../lib/site';

/**
 * 분류 페이지는 빌드 시점에 전부 만들어진다 — 서버가 필요 없다.
 *
 * 게임만 제외한다. 내용물이 계산기가 아니라 외부 링크고
 * 제목도 "게임 계산기"가 되어버려서, /game 은 전용 페이지로 따로 둔다.
 */
export function getStaticPaths() {
  return CATEGORIES.filter((c) => c.id !== 'game').map((c) => ({
    params: { category: c.id },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const items = calculatorsIn(category.id as CategoryId);
---

<Base
  title={`${category.label} 계산기`}
  description={`${category.blurb} 관련 계산기 모음. 모든 계산은 브라우저에서 처리됩니다.`}
  activeCategory={category.id}
>
  <main class="wrap">
    <section class="head">
      <nav class="crumb" aria-label="현재 위치">
        <a href="/">계산기</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{category.label}</span>
      </nav>
      <h1>{category.label} 계산기</h1>
      <p class="lede">{category.blurb}</p>
    </section>

    <CalculatorGrid targets={items} />
  </main>
</Base>

<style>
  .head {
    padding: 32px 0 4px;
  }

  .crumb {
    font-size: 13px;
    color: var(--ink-3);
    font-weight: 500;
    display: flex;
    gap: 7px;
    margin-bottom: 14px;
  }

  .crumb a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
</style>
