---
import Calculator from '../../layouts/Calculator.astro';
import AgeCalculator from '../../islands/AgeCalculator.svelte';
import { findCalculator } from '../../lib/site';
import { toISO } from '../../lib/date';

const meta = findCalculator('korean-age')!;

// 기본 날짜는 빌드 시점 기준. 클라이언트에서 실제 오늘로 맞춘다.
const build = new Date();
const defaultBaseDate = toISO(
  new Date(Date.UTC(build.getUTCFullYear(), build.getUTCMonth(), build.getUTCDate())),
);
const defaultBirthDate = '1990-01-01';

const faq = [
  {
    q: '만 나이 통일법이 시행됐는데 왜 나이가 세 개인가요?',
    a: '법령과 공문서는 만 나이로 통일됐지만, 병역법과 청소년보호법은 여전히 연 나이를 씁니다. 세는 나이는 공식 기준에서 사라졌지만 일상 대화에는 남아 있습니다.',
  },
  {
    q: '술·담배는 되는데 성인이 아니라는 게 무슨 말인가요?',
    a: '청소년보호법은 연 나이 19세를 기준으로 해서 생일과 관계없이 그 해 1월 1일부터 술·담배를 살 수 있습니다. 반면 민법상 성년은 만 19세라 생일이 지나야 합니다. 그래서 생일 전까지 몇 달간 술은 되지만 법적 성인은 아닌 구간이 생깁니다.',
  },
  {
    q: '생일 당일에 나이가 오르나요?',
    a: '만 나이는 생일 당일에 한 살 늘어납니다. 태어난 날은 만 0세이고, 첫 생일에 만 1세가 됩니다.',
  },
  {
    q: '2월 29일에 태어나면 평년에는 언제 나이를 먹나요?',
    a: '법적으로는 2월 28일이 지나면 나이가 오른 것으로 봅니다. 이 계산기도 평년에는 2월 28일을 기준으로 처리합니다.',
  },
  {
    q: '연 나이는 어떻게 계산하나요?',
    a: '올해 연도에서 태어난 해를 빼면 됩니다. 생일과 무관하므로 1월 1일에 모두가 한 살씩 올라갑니다.',
  },
  {
    q: '세는 나이는 왜 아직도 쓰나요?',
    a: '오래 굳어진 관습이라 대화에서는 여전히 쓰입니다. 다만 계약·의료·행정 등 공식적인 자리에서는 만 나이가 기준이므로, 헷갈릴 때는 "만 몇 살"인지 확인하는 편이 안전합니다.',
  },
];
---

<Calculator
  {meta}
  faq={faq}
  lede="생년월일을 넣으면 만 나이·연 나이·세는 나이를 한 번에 계산합니다. 성인·주민등록증 등 나이 기준에 언제 도달하는지도 알려줍니다."
  notes={['만 나이 통일법 반영', '세 가지 나이 비교']}
>
  <AgeCalculator client:load {defaultBaseDate} {defaultBirthDate} />

  <Fragment slot="content">
    <section class="block prose">
      <h2>한국에는 나이가 세 개 있습니다</h2>
      <p>
        2023년 6월 만 나이 통일법이 시행됐지만, 실제로는 세 가지 나이가 여전히 함께 쓰입니다.
      </p>

      <h3>만 나이</h3>
      <p>
        태어나면 0살이고 <strong>생일마다 한 살</strong> 늘어납니다. 법령·공문서·계약의 기본
        기준입니다. 나이를 말할 때 아무 설명이 없으면 만 나이로 봅니다.
      </p>

      <h3>연 나이</h3>
      <p>
        <strong>올해 연도 − 태어난 해</strong>입니다. 생일과 관계없이 1월 1일에 모두가 한 살씩
        올라갑니다. 병역법과 청소년보호법(술·담배)에서 씁니다.
      </p>

      <h3>세는 나이</h3>
      <p>
        태어나면 1살이고 새해마다 한 살 늘어납니다. 공식 기준에서는 사라졌지만 일상 대화에는
        남아 있습니다.
      </p>

      <h2>"술은 되는데 성인은 아니다"</h2>
      <p>
        가장 헷갈리는 구간입니다. 2008년 6월 15일생을 예로 들면,
      </p>
      <ul>
        <li><strong>2027년 1월 1일</strong> — 연 나이 19세가 되어 술·담배 구입 가능</li>
        <li><strong>2027년 6월 15일</strong> — 만 19세가 되어 법적 성인</li>
      </ul>
      <p>
        그 사이 약 5개월 반 동안은 술은 살 수 있지만 민법상 성년은 아닙니다. 계약이나 금융
        거래에서는 여전히 미성년자로 취급됩니다.
      </p>

      <h2>만 나이를 확인해야 하는 순간</h2>
      <ul>
        <li>계약·금융 거래 — 만 19세 이상이어야 단독으로 가능합니다</li>
        <li>의료 — 진료비 감면, 예방접종 대상 기준이 만 나이입니다</li>
        <li>복지 — 기초연금·경로우대는 만 65세부터입니다</li>
        <li>취업·정년 — 법정 정년은 만 60세입니다</li>
      </ul>

      <h2>이 계산에 반영되지 않은 것</h2>
      <ul>
        <li>학년 기준 나이 — 초등학교 입학은 만 6세가 되는 해의 다음 해 3월입니다</li>
        <li>병역 판정 검사 등 개별 법령의 세부 기준</li>
        <li>보험 나이 — 보험은 만 나이에서 6개월이 지나면 반올림하는 별도 기준을 씁니다</li>
      </ul>

      <p class="disclaimer">
        이 계산기는 참고용입니다. 개별 제도의 적용 기준은 관련 법령에 따라 다를 수 있으니
        정확한 확인이 필요하면 해당 기관에 문의하시기 바랍니다.
      </p>
    </section>
  </Fragment>
</Calculator>
