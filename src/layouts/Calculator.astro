---
/**
 * 계산기 페이지의 공통 뼈대.
 *
 * 계산기를 추가할 때 반복되는 것 — 빵부스러기, 신뢰 배지, 광고 자리 규칙,
 * 체이닝, 면책 문구, 구조화 데이터 — 를 전부 여기서 처리한다.
 * 개별 페이지는 계산기 본체와 설명 콘텐츠만 채우면 된다.
 */
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import CalculatorGrid from '../components/CalculatorGrid.astro';
import { CATEGORIES, chainTargets, type CalculatorMeta } from '../lib/site';
import { ratesFor } from '../lib/rates';

interface Faq {
  q: string;
  a: string;
}

interface Props {
  meta: CalculatorMeta;
  /** 제목 아래 한 문단. 없으면 summary를 쓴다. */
  lede?: string;
  /** 신뢰 배지 옆에 덧붙일 짧은 문구들 */
  notes?: string[];
  /** 자주 묻는 질문. 화면에도 나오고 FAQPage 구조화 데이터로도 나간다. */
  faq?: Faq[];
  /**
   * 요율 출처를 직접 지정한다.
   * 연도별 요율(4대보험·세율)을 쓰지 않는 계산기 — 중개보수처럼 개정 시점 기준인 것 — 에 쓴다.
   */
  sources?: { label: string; url: string }[];
  /** 출처 블록 제목에 들어갈 기준 표기. 기본은 "{연도}년 기준". */
  sourcesLabel?: string;
}

const { meta, lede, notes = [], faq = [], sources, sourcesLabel } = Astro.props;

// 세율·요율이 걸린 계산기는 어떤 자료를 근거로 했는지 밝힌다.
// 숫자를 믿을 수 있는지가 이 사이트의 전부라서, 출처를 숨기지 않는다.
const yearRates = meta.basisYear ? ratesFor(meta.basisYear) : null;
const sourceList = sources ?? yearRates?.sources ?? null;
const sourceHeading = sourcesLabel ?? (yearRates ? `${yearRates.year}년 기준` : '');

const category = CATEGORIES.find((c) => c.id === meta.category)!;
const targets = chainTargets(meta);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = Astro.site?.origin ?? '';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.title,
    description: meta.summary,
    url: canonical,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    inLanguage: 'ko-KR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '계산기', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: category.label, item: `${origin}/${category.id}` },
      { '@type': 'ListItem', position: 3, name: meta.title, item: canonical },
    ],
  },
];

if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<Base title={meta.title} description={meta.summary} activeCategory={meta.category}>
  <main class="wrap page">
    <nav class="crumb" aria-label="현재 위치">
      <a href="/">계산기</a>
      <span aria-hidden="true">›</span>
      <a href={`/${category.id}`}>{category.label}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{meta.short}</span>
    </nav>

    <h1>{meta.title}</h1>
    <p class="lede">{lede ?? meta.summary}</p>

    <div class="badges head-badges">
      <span class="badge badge--trust">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        입력값은 서버로 전송되지 않습니다
      </span>
      {meta.basisYear && <span class="badge">{meta.basisYear}년 기준</span>}
      {notes.map((n) => <span class="badge">{n}</span>)}
    </div>

    {/* 계산기 본체 */}
    <slot />

    {/* 광고는 결과가 모두 노출된 다음에만 */}
    <AdSlot placement={`${meta.slug}-below-result`} />

    {/* 상환표·상세 등 결과에 딸린 내용 */}
    <slot name="detail" />

    <CalculatorGrid
      targets={targets}
      heading="이어서 계산해보기"
      sub="지금 보고 있는 값과 이어지는 계산기입니다."
    />

    <AdSlot placement={`${meta.slug}-mid-content`} />

    {/* 설명 콘텐츠 — 검색 유입과 애드센스 승인 양쪽에 필요하다 */}
    <slot name="content" />

    {
      sourceList && sourceList.length > 0 && (
        <section class="block">
          <details class="sources">
            <summary>
              {sourceHeading} 요율·세율 출처
              <span class="verified">대조 완료</span>
            </summary>
            <div class="sources-body">
              <p class="sources-lede">
                이 계산기에 쓰인 요율과 세율은 아래 공식 자료를 근거로 합니다. 기준이 바뀌면
                갱신합니다.
              </p>
              <ul>
                {sourceList.map((source) => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      {source.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="block">
          <h2>자주 묻는 질문</h2>
          <div class="faq">
            {faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .page {
    padding: 32px 0 0;
  }

  .crumb {
    font-size: 13px;
    color: var(--ink-3);
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 14px;
  }

  .crumb a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .head-badges {
    margin: 18px 0 28px;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 65ch;
  }

  .faq details {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .faq summary {
    padding: 14px 17px;
    cursor: pointer;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    margin-left: auto;
    color: var(--ink-3);
    font-family: var(--f-mono);
    flex: none;
  }

  .faq details[open] summary::after {
    content: '−';
  }

  .faq p {
    margin: 0;
    padding: 0 17px 16px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .sources {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    max-width: 65ch;
  }

  .sources summary {
    padding: 14px 17px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .sources summary::-webkit-details-marker {
    display: none;
  }

  .sources summary::after {
    content: '+';
    margin-left: auto;
    color: var(--ink-3);
    font-family: var(--f-mono);
  }

  .sources[open] summary::after {
    content: '−';
  }

  .verified {
    font-size: 11px;
    font-weight: 600;
    font-family: var(--f-mono);
    color: var(--accent-ink);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .sources-body {
    padding: 0 17px 16px;
  }

  .sources-lede {
    font-size: 13px;
    color: var(--ink-3);
    margin: 0 0 10px;
  }

  .sources-body ul {
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .sources-body li {
    margin-bottom: 5px;
  }
</style>
